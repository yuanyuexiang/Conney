# Set a new non-empty password before starting the stack.
RELAY_DB_PASSWORD=
RELAY_DB_NAME=relay
RELAY_DB_USER=relay
RELAY_HTTP_PORT=8080

# Use a persistent Fernet key for mailbox authorization codes.
# Set secure cookies when serving behind HTTPS.
RELAY_COOKIE_SECURE=false
RELAY_MAIL_ENCRYPTION_KEY=
